{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "KeyVault": {
    "Uri": "https://easycart-kv.vault.azure.net/"
  },

  "Database": {
    "ApplyMigrations": true
  },

  "OpenTelemetry": {
    "ServiceName": "ProductService",
    "Endpoint": "http://localhost:4317"
  },

  "Serilog": {
    "FileName": "Serilog/ProductApi.log"
  },

  "GatewayProtection": {
    "Enabled": false
  }
}
