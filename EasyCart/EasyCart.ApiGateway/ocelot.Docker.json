{
  "Routes": [
    
    {
      "DownstreamPathTemplate": "/api/authentication/{url}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "easycart-auth",
          "Port": 8080
        }
      ],
      "UpstreamHttpMethod": [ "GET", "POST" ],
      "UpstreamPathTemplate": "/api/authentication/{url}",
      "RateLimitOptions": {
        "ClientWhitelist": [],
        "ClientIdHeader": "X-Api-Gateway",
        "EnableRateLimiting": true,
        "Limit": 100,
        "Period": "1m",
        "PeriodTimespan": 1
      }
    },

    {
      "DownstreamPathTemplate": "/api/products",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "easycart-product",
          "Port": 8080
        }
      ],
      "UpstreamHttpMethod": [ "GET" ],
      "UpstreamPathTemplate": "/api/products",
      "RateLimitOptions": {
        "EnableRateLimiting": false
      },
      "FileCacheOptions": {
        "TtlSeconds": 60,
        "Region": "default",
        "Header": "EasyCart-Caching-Control"
      }
    },

    {
      "DownstreamPathTemplate": "/api/products/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "easycart-product",
          "Port": 8080
        }
      ],
      "UpstreamHttpMethod": [ "GET" ],
      "UpstreamPathTemplate": "/api/products/{id}",
      "RateLimitOptions": {
        "EnableRateLimiting": false
      },
      "FileCacheOptions": {
        "TtlSeconds": 60,
        "Region": "default",
        "Header": "EasyCart-Product-Caching-Control"
      }
    },

    {
      "DownstreamPathTemplate": "/api/products/{url}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "easycart-product",
          "Port": 8080
        }
      ],
      "UpstreamHttpMethod": [ "POST", "PUT", "DELETE" ],
      "UpstreamPathTemplate": "/api/products/{url}",
      "AuthenticationOptions": {
        "AllowedScopes": [],
        "AuthenticationProviderKey": "Bearer"
      }
    },

    {
      "DownstreamPathTemplate": "/api/orders",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "easycart-order",
          "Port": 8080
        }
      ],
      "UpstreamHttpMethod": [ "GET" ],
      "UpstreamPathTemplate": "/api/orders",
      "FileCacheOptions": {
        "TtlSeconds": 10,
        "Region": "default",
        "Header": "EasyCart-Order-Caching-Control"
      },
      "AuthenticationOptions": {
        "AllowedScopes": [],
        "AuthenticationProviderKey": "Bearer"
      }
    },

    {
      "DownstreamPathTemplate": "/api/orders/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "easycart-order",
          "Port": 8080
        }
      ],
      "UpstreamHttpMethod": [ "GET" ],
      "UpstreamPathTemplate": "/api/orders/{id}",
      "FileCacheOptions": {
        "TtlSeconds": 10,
        "Region": "default",
        "Header": "EasyCart-Product-Caching-Control"
      },
      "AuthenticationOptions": {
        "AllowedScopes": [],
        "AuthenticationProviderKey": "Bearer"
      }
    },

    {
      "DownstreamPathTemplate": "/api/orders/{url}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "easycart-order",
          "Port": 8080
        }
      ],
      "UpstreamHttpMethod": [ "POST", "PUT", "DELETE" ],
      "UpstreamPathTemplate": "/api/orders/{url}",
      "AuthenticationOptions": {
        "AllowedScopes": [],
        "AuthenticationProviderKey": "Bearer"
      }
    },

    {
      "DownstreamPathTemplate": "/api/cart",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "easycart-order",
          "Port": 8080
        }
      ],
      "UpstreamHttpMethod": [ "GET", "DELETE" ],
      "UpstreamPathTemplate": "/api/cart",
      "AuthenticationOptions": {
        "AllowedScopes": [],
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/cart/{url}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "easycart-order",
          "Port": 8080
        }
      ],
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "UpstreamPathTemplate": "/api/cart/{url}",
      "AuthenticationOptions": {
        "AllowedScopes": [],
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/inventory/{url}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "easycart-inventory",
          "Port": 8080
        }
      ],
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "UpstreamPathTemplate": "/api/inventory/{url}",
      "AuthenticationOptions": {
        "AllowedScopes": [],
        "AuthenticationProviderKey": "Bearer"
      }
    }
  ],

  "GlobalConfiguration": {
    "BaseUrl": "http://easycart-api-gateway:8080",
    "RateLimitOptions": {
      "ClientIdHeader": "X-Api-Gateway",
      "QuotaExceededMessage": "Requests limit exceeded, Please try later",
      "Limit": 5,
      "Period": "1m",
      "PeriodTimespan": 5
    }
  }
}
