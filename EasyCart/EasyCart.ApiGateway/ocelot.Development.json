{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/authentication/{url}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5000
        }
      ],
      "UpstreamHttpMethod": [ "GET", "POST" ],
      "UpstreamPathTemplate": "/api/authentication/{url}",
      "RateLimitOptions": {
        "ClientWhitelist": [],
        "ClientIdHeader": "X-Api-Gateway",
        "EnableRateLimiting": true,
        "Limit": 100,
        "Period": "1m",
        "PeriodTimespan": 1
      }
    },
    {
      "DownstreamPathTemplate": "/api/products/",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5001
        }
      ],
      "UpstreamHttpMethod": [ "GET" ],
      "UpstreamPathTemplate": "/api/products/"
    },
    {
      "DownstreamPathTemplate": "/api/products/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5001
        }
      ],
      "UpstreamHttpMethod": [ "GET" ],
      "UpstreamPathTemplate": "/api/products/{id}"
    },
    {
      "DownstreamPathTemplate": "/api/products/{url}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5001
        }
      ],
      "UpstreamHttpMethod": [ "POST", "PUT", "DELETE" ],
      "UpstreamPathTemplate": "/api/products/{url}",
      "AuthenticationOptions": {
        "AllowedScopes": [],
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "DownstreamPathTemplate": "/api/orders/",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5002
        }
      ],
      "UpstreamHttpMethod": [ "GET" ],
      "UpstreamPathTemplate": "/api/orders/"
    },
    {
      "DownstreamPathTemplate": "/api/orders/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5002
        }
      ],
      "UpstreamHttpMethod": [ "GET" ],
      "UpstreamPathTemplate": "/api/orders/{id}"
    },
    {
      "DownstreamPathTemplate": "/api/orders/{url}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5002
        }
      ],
      "UpstreamHttpMethod": [ "POST", "PUT", "DELETE" ],
      "UpstreamPathTemplate": "/api/orders/{url}"
    },
    {
      "DownstreamPathTemplate": "/api/inventory/{url}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5004
        }
      ],
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "UpstreamPathTemplate": "/api/inventory/{url}"
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "https://localhost:5003",
    "RateLimitOptions": {
      "ClientIdHeader": "X-Api-Gateway",
      "QuotaExceededMessage": "Requests limit exceeded, Please try later",
      "Limit": 5,
      "Period": "1m",
      "PeriodTimespan": 5
    }
  }
}
